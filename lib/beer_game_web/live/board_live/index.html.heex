<h1>Listing Board</h1>

<table>
  <thead>
    <tr>
      <th>State</th>
      <th>finished</th>

      <th></th>
    </tr>
  </thead>
  <tbody id="board">
    <%= for board <- @board_collection do %>
      <tr id={"board-#{board.id}"}>
        <td>{board.state}</td>
        <td>{board.full}</td>

        <td>
          <span><.link navigate={~p"/board/#{board}/player"}>Show</.link></span>
          <span><button phx-click="delete" phx-value-id={board.id} data-confirm="Are you sure?">Delete</button></span>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<span><.link navigate={~p"/board/new"}>New Board</.link></span>

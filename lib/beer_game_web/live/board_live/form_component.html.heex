<section class="entry-panel" aria-labelledby="new-board-title">
  <h2 id="new-board-title">Make room for your group.</h2>
  <p>Choose a board name you can share with the other players.</p>
  <.form for={@form} id="board-form" phx-submit="create_board" class="entry-form">
    <div class="field">
      <label for="name">Board name</label>
      <input
        type="text"
        name="name"
        id="name"
        value={@form[:name].value}
        placeholder="e.g. team-AB"
        autofocus
        autocomplete="off"
        aria-invalid={@form[:name].errors != []}
        aria-describedby="new-board-name-hint board-name-errors"
      />
      <p id="new-board-name-hint" class="field-hint">Your group will use this name to join.</p>
      <div id="board-name-errors">
        <p :for={error <- @form[:name].errors} class="invalid-feedback">
          {translate_error(error)}
        </p>
      </div>
    </div>
    <button class="button button-primary button-full" type="submit" phx-disable-with="Creating…">Create Board
    <.icon name="arrow" /></button>
  </.form>
  <div class="entry-secondary">
    <span>Already have a board?</span>
    <.link navigate={~p"/"} class="text-link">Join instead <.icon name="arrow" /></.link>
  </div>
</section>

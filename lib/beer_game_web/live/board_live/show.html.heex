<div class="game-page">
  <header class="page-heading game-heading">
    <div>
      <h1>Board {@board.name}</h1>
      <p class="role-label">Role {@player.role}</p>
    </div>
    <button class="button button-secondary" phx-click="abandon_game">Quit Game</button>
  </header>
  <div class="game-chain">
    <span>Your place in the chain</span>
    <.supply_chain role={@player.role} />
  </div>
  <div class="game-grid">
    <section class="inventory-panel" aria-labelledby="inventory-title">
      <div class="inventory-summary">
        <h2 id="inventory-title">Current status</h2>
        <dl class="inventory-values">
          <div>
            <dt>Stock</dt><dd class={@player.stock <= 10 && "low-stock"}>{@player.stock}</dd>
          </div>
          <div>
            <dt>Last week</dt><dd>{@player.last_order}</dd>
          </div>
        </dl>
        <p :if={@player.stock <= 10} class="stock-warning">Low stock. Keep an eye on demand.</p>
      </div>
      <form phx-submit="create_order" class="order-form">
        <div class="field">
          <label for="amount">{if @player.role == "factory",
            do: "Weekly production",
            else: "Weekly order"}</label>
          <p class="field-hint">
            {if @player.role == "factory",
              do: "Set how much beer to produce.",
              else: "Set how much beer to request."}
          </p>
          <div class="quantity-input">
            <input type="number" name="amount" id="amount" value={@player.weekly_orders} /><span aria-hidden="true">units</span>
          </div>
        </div>
        <input
          :if={@player.role != "factory" and @order_time}
          class="button button-primary button-full"
          type="submit"
          value="Place order"
          phx-disable-with="Ordering…"
        />
        <button
          :if={@player.role == "factory"}
          class="button button-primary button-full"
          type="submit"
          phx-disable-with="Saving…"
        >Save production</button>
        <p :if={@player.role != "factory" and !@order_time} class="waiting-note">
          Waiting for the next ordering window.
        </p>
      </form>
    </section>
    <section class="table-panel" aria-labelledby="incoming-title">
      <div class="panel-heading">
        <h2 id="incoming-title"><.icon name="incoming" /> Incoming</h2><span class="count-label">{length(
          @receiving_orders
        )} orders</span>
      </div>
      <div class="table-scroll">
        <table class="data-table order-table">
          <caption class="sr-only">Incoming beer orders</caption>
          <thead>
            <tr>
              <th scope="col">Order</th><th scope="col" class="number-cell">Quantity</th><th scope="col">
                Status
              </th>
            </tr>
          </thead>
          <tbody>
            <tr :for={order <- @receiving_orders} id={"incoming-#{order.id}"}>
              <th scope="row">#{order.id}</th><td class="number-cell">{order.amount}</td><td>
                <.status state={order.state} />
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div :if={@receiving_orders == []} class="empty-state order-empty">
        <.icon name="incoming" />
        <h3>Nothing incoming yet.</h3>
        <p>Your incoming orders will appear here.</p>
      </div>
    </section>
    <section class="table-panel" aria-labelledby="outgoing-title">
      <div class="panel-heading">
        <h2 id="outgoing-title"><.icon name="outgoing" /> Outgoing</h2><span class="count-label">{length(
          @sending_orders
        )} orders</span>
      </div>
      <div class="table-scroll">
        <table class="data-table order-table outgoing-table">
          <caption class="sr-only">Outgoing beer orders and delivery actions</caption>
          <thead>
            <tr>
              <th scope="col">Order</th><th scope="col" class="number-cell">Quantity</th><th scope="col">
                Status
              </th><th scope="col">Action</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={order <- @sending_orders} id={"outgoing-#{order.id}"}>
              <th scope="row">#{order.id}</th><td class="number-cell">{order.amount}</td><td>
                <.status state={order.state} />
              </td>
              <td>
                <%= if order.state == "PENDING" do %>
                  <button
                    :if={@player.stock >= order.amount}
                    class="button button-deliver"
                    phx-click="deliver_order"
                    phx-value-order_id={order.id}
                    phx-disable-with="Sending…"
                  >Deliver</button>
                  <button
                    :if={@player.stock < order.amount}
                    disabled
                    class="button button-deliver"
                  >No Stock</button>
                <% else %>
                  <span class="unavailable-action">N/A</span>
                <% end %>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div :if={@sending_orders == []} class="empty-state order-empty">
        <.icon name="outgoing" />
        <h3>No orders to send.</h3>
        <p>When orders arrive, deliver them from your stock.</p>
      </div>
    </section>
  </div>
</div>

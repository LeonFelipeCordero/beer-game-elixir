<div class="h-screen grid place-content-center">
  <div class="w-full max-w-xs">
    <.form
      for={@form}
      id="join-board-form"
      phx-submit="join_board"
      class="bg-slate-100 shadow-md rounded px-8 pt-6 pb-8 mb-4"
    >
      <div class="mb-4">
        <label for="name" class="block text-gray-700 text-xl font-bold mb-2">Board name.</label>
        <input
          class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:shadow-outline"
          type="text"
          name="name"
          id="name"
          value={@form[:name].value}
          placeholder="e.g. team-AB"
          autofocus
          autocomplete="off"
        />
      </div>
      <div>
        <input
          class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline"
          type="submit"
          value="Join Board"
        />

        <.link
          navigate={~p"/board/new"}
          class="inline-block align-baseline font-bold text-sm text-blue-500 hover:text-blue-800"
        >New Board</.link>
      </div>

      <div class=""></div>
    </.form>
  </div>
</div>

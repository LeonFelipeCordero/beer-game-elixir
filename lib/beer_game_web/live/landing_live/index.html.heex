<div class="setup-page">
  <.setup_steps current={1} />
  <div class="welcome-grid">
    <section class="welcome-story" aria-labelledby="welcome-title">
      <h1 id="welcome-title">Small orders.<br /><span>Big ripple effects.</span></h1>
      <p class="lead">
        One supply chain. Three perspectives. Discover how your decisions shape the whole system.
      </p>
    </section>
    <section class="entry-panel" aria-labelledby="join-title">
      <h2 id="join-title">Take your place.</h2>
      <p>Have a board name? Join your group and choose your role.</p>
      <.form for={@form} id="join-board-form" phx-submit="join_board" class="entry-form">
        <div class="field">
          <label for="name">Board name</label>
          <input
            type="text"
            name="name"
            id="name"
            value={@form[:name].value}
            placeholder="e.g. team-AB"
            autofocus
            autocomplete="off"
            aria-describedby="board-name-hint"
          />
          <p id="board-name-hint" class="field-hint">Use the name shared by your group.</p>
        </div>
        <button
          class="button button-primary button-full"
          type="submit"
          phx-disable-with="Joining…"
        >Join Board <.icon name="arrow" /></button>
      </.form>
      <div class="entry-secondary">
        <span>Starting a new group?</span>
        <.link navigate={~p"/board/new"} class="text-link">New Board <.icon name="arrow" /></.link>
      </div>
    </section>
    <div class="chain-panel">
      <div class="chain-panel-heading">
        <h2>Every link matters.</h2><.icon name="box" />
      </div>
      <.supply_chain />
      <p>Beer moves downstream. Orders travel back.<br />What happens in between is up to you.</p>
    </div>
  </div>
</div>
